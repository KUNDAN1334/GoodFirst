# Copy this file to .env and edit as needed:  copy .env.example .env
# Every line is optional; the values shown are the defaults.

# ---- Local model (Ollama) -----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Default: Gemma 3 4B (~3.3 GB download). On a slow or busy 8 GB laptop,
# switch to the 1B model (~815 MB):  OLLAMA_MODEL=gemma3:1b
OLLAMA_MODEL=gemma3:4b
# Context window in tokens. Bigger = more RAM and slower on CPU.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
# CPU inference can be slow; seconds to wait for one model answer.
OLLAMA_TIMEOUT_S=300

# ---- GitHub (read-only) -------------------------------------------------
# Optional. Without a token GitHub allows 60 requests/hour; with one, 5000.
# A fine-grained token with NO extra permissions (public repos, read-only) is enough.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# ---- Honesty layer --------------------------------------------------------
# Below this confidence the UI shows "low confidence" + an ask-the-maintainer question.
CONFIDENCE_FLOOR=0.6
# Max confidence allowed when the repo has neither README nor CONTRIBUTING.
NO_DOCS_CONFIDENCE_CAP=0.3

# ---- Prompt size limits (characters) -------------------------------------
MAX_README_CHARS=6000
MAX_CONTRIBUTING_CHARS=4000
MAX_ISSUE_BODY_CHARS=600
MAX_ISSUES=15

# ---- Cache for GitHub responses -----------------------------------------
GOODFIRST_CACHE_DIR=.cache
# Seconds to keep cached GitHub responses. 0 disables caching.
CACHE_TTL_S=3600
